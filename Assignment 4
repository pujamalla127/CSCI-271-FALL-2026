# include <iostream>   // gives access to cin and cout

using namespace std;     // lets us write cout instead of std::cout

int main(){               
int whole_num;           // initialising the whole_num varibale to store the  user's input 

cout << "please enter the whole number: " << endl; //prints the message to the screen

cin >> whole_num;     //asks for the user input and store the value in the variable 

for (int i = 1; i <= 10; i++ ) {   // starts i=1 , loop keep running until the i <=10 
    // and increase i by 1 everytime the loop runs 

    cout << whole_num << "*" << i << "=" << whole_num * i  << endl; //multiplies the user number 
    //by i and display the result 
}

return 0;  // program ends 
}

